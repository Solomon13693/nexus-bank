{
  "expo": {
    "name": "Nexus Bank",
    "slug": "nexus-bank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/app-icon/icon.png",
    "scheme": "nexusbank",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/img/app-icon/icon.png",
      "bundleIdentifier": "com.anonymous.nexus-bank"
    },
    "android": {
      "package": "com.anonymous.nexusbank",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/img/app-icon/android-icon-foreground.png",
        "backgroundImage": "./assets/img/app-icon/android-icon-background.png",
        "monochromeImage": "./assets/img/app-icon/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/img/app-icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/img/splash.png",
          "enableFullScreenImage_legacy": true,
          "resizeMode": "cover",
          "ios": {
            "image": "./assets/img/splash.png",
            "backgroundColor": "#0A0A0A"
          },
          "android": {
            "image": "./assets/img/app-icon/splash-icon.png",
            "imageWidth": 300,
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "assets/fonts/sora/Sora-Light.ttf",
            "assets/fonts/sora/Sora-Regular.ttf",
            "assets/fonts/sora/Sora-Medium.ttf",
            "assets/fonts/sora/Sora-SemiBold.ttf",
            "assets/fonts/sora/Sora-Bold.ttf",
            "assets/fonts/sora/Sora-ExtraBold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
